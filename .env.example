# ============================================================
# CaloriePro v7.1 — Environment Variables
# Set these in Vercel Project Settings → Environment Variables
# NEVER commit real secrets to version control
# ============================================================

# Supabase — Required for server APIs (SERVICE_KEY never in client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Turso — Required for /api/sync backup
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Resend — Required for /api/email and admin send-email
RESEND_API_KEY=re_your_key

# Hugging Face — Required for /api/ai (Salo AI Coach)
# Create a token at https://huggingface.co/settings/tokens with
# "Make calls to Inference Providers" permission enabled.
HF_TOKEN=hf_your_token
# Optional — defaults to Qwen/Qwen2.5-7B-Instruct-1M if unset. Any chat
# model id from https://huggingface.co/docs/inference-providers works;
# append :<provider> (e.g. :groq) to pin a specific provider.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M

# App
APP_URL=https://calorie-pro.vercel.app
ADMIN_EMAIL=your-admin@email.com
